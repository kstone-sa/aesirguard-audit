{
  "version": "1",
  "record_types": {
    "LOGIN": {"category": "session", "action": "set_audit_attribution"},
    "USER_CMD": {"category": "process", "action": "user_command"},
    "USER_AUTH": {"category": "authentication", "action": "authenticate"},
    "USER_ACCT": {"category": "authentication", "action": "check_account"},
    "USER_LOGIN": {"category": "authentication", "action": "login"},
    "USER_LOGOUT": {"category": "authentication", "action": "logout"},
    "USER_START": {"category": "session", "action": "start_session"},
    "USER_END": {"category": "session", "action": "end_session"},
    "CRED_ACQ": {"category": "authentication", "action": "acquire_credentials"},
    "CRED_DISP": {"category": "authentication", "action": "dispose_credentials"},
    "CRED_REFR": {"category": "authentication", "action": "refresh_credentials"},
    "USER_CHAUTHTOK": {"category": "identity", "action": "change_credentials"},
    "GRP_CHAUTHTOK": {"category": "identity", "action": "change_group_credentials"},
    "USER_MGMT": {"category": "identity", "action": "modify_user"},
    "GRP_MGMT": {"category": "identity", "action": "modify_group"},
    "ADD_USER": {"category": "identity", "action": "create_user"},
    "DEL_USER": {"category": "identity", "action": "delete_user"},
    "ADD_GROUP": {"category": "identity", "action": "create_group"},
    "DEL_GROUP": {"category": "identity", "action": "delete_group"},
    "ACCT_LOCK": {"category": "identity", "action": "lock_account"},
    "ACCT_UNLOCK": {"category": "identity", "action": "unlock_account"},
    "USER_ERR": {"category": "authentication", "action": "authentication_error"},

    "SYSTEM_BOOT": {"category": "system", "action": "boot"},
    "SYSTEM_SHUTDOWN": {"category": "system", "action": "shutdown"},
    "SYSTEM_RUNLEVEL": {"category": "system", "action": "change_runlevel"},
    "SERVICE_START": {"category": "service", "action": "start_service"},
    "SERVICE_STOP": {"category": "service", "action": "stop_service"},
    "SOFTWARE_UPDATE": {"category": "package", "action": "update_software"},

    "DAEMON_START": {"category": "audit", "action": "start_audit_daemon"},
    "DAEMON_END": {"category": "audit", "action": "stop_audit_daemon"},
    "DAEMON_ABORT": {"category": "audit", "action": "abort_audit_daemon"},
    "DAEMON_ERR": {"category": "audit", "action": "audit_daemon_error"},
    "DAEMON_CONFIG": {"category": "audit", "action": "configure_audit_daemon"},
    "DAEMON_ROTATE": {"category": "audit", "action": "rotate_audit_log"},
    "DAEMON_RESUME": {"category": "audit", "action": "resume_audit_logging"},
    "CONFIG_CHANGE": {"category": "audit", "action": "change_audit_configuration"},
    "FEATURE_CHANGE": {"category": "audit", "action": "change_audit_feature"},

    "AVC": {"category": "access_control", "action": "enforce_access_control"},
    "USER_AVC": {"category": "access_control", "action": "enforce_access_control"},
    "SELINUX_ERR": {"category": "access_control", "action": "policy_error"},
    "USER_SELINUX_ERR": {"category": "access_control", "action": "policy_error"},
    "APPARMOR_DENIED": {"category": "access_control", "action": "enforce_access_control"},
    "APPARMOR_ALLOWED": {"category": "access_control", "action": "enforce_access_control"},
    "APPARMOR_KILL": {"category": "access_control", "action": "terminate_by_policy"},
    "APPARMOR_ERROR": {"category": "access_control", "action": "policy_error"},
    "APPARMOR_STATUS": {"category": "access_control", "action": "change_policy_status"},
    "MAC_STATUS": {"category": "access_control", "action": "change_policy_status"},
    "MAC_POLICY_LOAD": {"category": "access_control", "action": "load_mac_policy"},

    "SECCOMP": {"category": "access_control", "action": "filter_syscall"},
    "BPF": {"category": "kernel", "action": "bpf_operation"},
    "CAPSET": {"category": "process", "action": "change_capabilities"},
    "BPRM_FCAPS": {"category": "process", "action": "apply_file_capabilities"},
    "KERN_MODULE": {"category": "kernel", "action": "kernel_module_operation"}
  },
  "record_prefixes": [
    {"prefix": "ANOM_", "category": "security", "action": "detect_anomaly"},
    {"prefix": "INTEGRITY_", "category": "integrity", "action": "check_integrity"}
  ],
  "seccomp_actions": {
    "00000000": {"action": "kill_thread", "event_action": "terminate_by_seccomp"},
    "80000000": {"action": "kill_process", "event_action": "terminate_by_seccomp"},
    "00030000": {"action": "trap", "event_action": "trap_syscall"},
    "00050000": {"action": "errno", "event_action": "block_syscall"},
    "7fc00000": {"action": "user_notif", "event_action": "notify_syscall"},
    "7ff00000": {"action": "trace", "event_action": "trace_syscall"},
    "7ffc0000": {"action": "log", "event_action": "log_syscall"},
    "7fff0000": {"action": "allow", "event_action": "allow_syscall"}
  },
  "single_record_types": [
    "USER_CMD", "USER_AUTH", "USER_ACCT", "USER_LOGIN", "USER_LOGOUT", "USER_START", "USER_END",
    "CRED_ACQ", "CRED_DISP", "CRED_REFR", "USER_CHAUTHTOK", "GRP_CHAUTHTOK",
    "USER_MGMT", "GRP_MGMT", "ADD_USER", "DEL_USER", "ADD_GROUP", "DEL_GROUP",
    "ACCT_LOCK", "ACCT_UNLOCK", "USER_ERR", "SYSTEM_BOOT", "SYSTEM_SHUTDOWN",
    "SYSTEM_RUNLEVEL", "SERVICE_START", "SERVICE_STOP", "SOFTWARE_UPDATE",
    "DAEMON_START", "DAEMON_END", "DAEMON_ABORT", "DAEMON_ERR", "DAEMON_CONFIG",
    "DAEMON_ROTATE", "DAEMON_RESUME", "USER_AVC"
  ]
}
